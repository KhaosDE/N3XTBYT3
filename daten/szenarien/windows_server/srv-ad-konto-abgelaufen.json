  "hinweise": [
    "Die Meldung sagt „expired“ – das Konto hat ein Ablaufdatum. Schau es dir an.",
    "„Get-ADUser trichter -Properties AccountExpirationDate“ zeigt es. Ändern geht mit „Set-ADAccountExpiration“. Achtung: Das Konto läuft zu Beginn des eingetragenen Tages ab.",
    "„Set-ADAccountExpiration -Identity trichter -DateTime 2027-03-01“ – dann gilt es bis einschließlich 28.02.2027."
  ],
  "erklaerung": [
    "Das Konto hatte als Ablaufdatum den 1.11.2026, 0:00 Uhr – also das Ende des 31.10.",
    "„Set-ADAccountExpiration“ setzt ein neues Datum. Das Konto läuft zu Beginn des angegebenen Tages ab;",
    "darum 2027-03-01, damit Tom am 28.02. noch arbeiten kann (in der AD-Konsole steht dann „Ende des 28.02.2027“).",
    "Das Datum im ISO-Format JJJJ-MM-TT versteht PowerShell unabhängig von der Spracheinstellung.",
    "„Clear-ADAccountExpiration“ entfernt das Datum ganz – für befristete Konten ist das ein Sicherheitsrisiko."
  ],
  "begriffe": {
    "AccountExpirationDate": "Zeitpunkt, ab dem sich ein Konto nicht mehr anmelden kann.",
    "Ablauf vs. Passwortablauf": "Das Konto läuft ab (Anmeldung unmöglich) – oder nur das Passwort (muss geändert werden).",
    "ISO-Datum": "Schreibweise JJJJ-MM-TT, z. B. 2027-03-01; überall eindeutig."
  },
  "loesung": [
    "Get-ADUser trichter -Properties AccountExpirationDate",
