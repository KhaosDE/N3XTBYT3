  "hinweise": [
    "Der Server hat eine neue Adresse. Woher „weiß“ der PC, welche Adresse zum Namen gehört – und könnte er sich die alte gemerkt haben?",
    "Vergleiche: Welche Adresse nennt „ping“ für den Namen, welche „nslookup“? Den Zwischenspeicher zeigt „ipconfig /displaydns“.",
    "Der PC hat sich die alte Adresse im DNS-Cache gemerkt. Leere den Cache mit „ipconfig /flushdns“."
  ],
  "erklaerung": [
    "Windows merkt sich Antworten des DNS-Servers eine Zeit lang im DNS-Cache (Zwischenspeicher).",
    "Frau Bergers PC hatte noch die alte Adresse 192.168.10.20 gespeichert – „ping“ und der Browser nehmen diese.",
    "„nslookup“ fragt dagegen direkt den DNS-Server und bekommt die neue Adresse 192.168.10.25.",
    "„ipconfig /flushdns“ leert den Cache. Danach fragt Windows neu nach und bekommt die richtige Adresse.",
    "In der PowerShell macht „Clear-DnsClientCache“ dasselbe."
  ],
  "begriffe": {
    "DNS": "Domain Name System: übersetzt Namen wie intranet.firma.internal in IP-Adressen.",
    "DNS-Cache": "Zwischenspeicher, in dem Windows schon gefragte Namen und ihre Adressen eine Zeit lang aufbewahrt.",
    "TTL (Time To Live)": "Wie viele Sekunden ein Eintrag noch im Cache bleibt. Bei ping: wie viele Netzwerk-Sprünge ein Paket noch darf.",
    "nslookup": "Werkzeug, das einen DNS-Server direkt fragt – am Cache vorbei.",
    "ping": "Schickt kleine Testpakete an einen Rechner und zeigt, ob und wie schnell er antwortet."
  },
  "loesung": [
    "ping intranet.firma.internal",
    "nslookup intranet.firma.internal",
    "ipconfig /flushdns",
    "ping intranet.firma.internal"
  ]
