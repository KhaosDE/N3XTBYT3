  "befehle": [
    {
      "muster": [
        "reg query HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "reg query HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"
      ],
      "bedeutung": "Werte eines Registrierungsschlüssels anzeigen",
      "frage": "Zeige die Autostart-Einträge des angemeldeten Benutzers (Run-Schlüssel unter HKCU) in cmd",
      "faelle": [
        {
          "wenn": {
            "autostart_toolbar": true,
            "autostart_onedrive": true
          },
          "ausgabe": [
            "",
            "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            "    OneDrive    REG_SZ    \"C:\\Users\\mberger\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe\" /background",
            "    SuperToolbarUpdater    REG_SZ    C:\\Users\\mberger\\AppData\\Roaming\\SuperToolbar\\updater.exe /silent",
            ""
          ]
        },
        {
          "wenn": {
            "autostart_toolbar": true
          },
          "ausgabe": [
            "",
            "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            "    SuperToolbarUpdater    REG_SZ    C:\\Users\\mberger\\AppData\\Roaming\\SuperToolbar\\updater.exe /silent",
            ""
          ]
        },
        {
          "wenn": {
            "autostart_onedrive": true
          },
          "ausgabe": [
            "",
            "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            "    OneDrive    REG_SZ    \"C:\\Users\\mberger\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive.exe\" /background",
            ""
          ]
        },
        {
          "ausgabe": [
            "",
            "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            ""
