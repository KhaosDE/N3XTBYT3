  "hinweise": [
    "Programme, die bei der Anmeldung starten, stehen oft in der Registrierung im Schlüssel „Run“ des Benutzers.",
    "Der Schlüssel heißt HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run. Anzeigen mit „reg query“, löschen mit „reg delete … /v <Name> /f“.",
    "„reg delete HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run /v SuperToolbarUpdater /f“."
  ],
  "erklaerung": [
    "Windows startet bei der Anmeldung alles, was im Run-Schlüssel steht: für alle Benutzer unter HKLM,",
    "für den angemeldeten Benutzer unter HKCU. Die Toolbar hatte sich in HKCU\\…\\Run eingetragen.",
    "„reg query“ zeigt die Einträge, „reg delete … /v SuperToolbarUpdater /f“ löscht genau diesen einen Wert.",
    "Vorsicht: Ohne „/v“ würde der ganze Schlüssel gelöscht. OneDrive und SecurityHealth sind normale Einträge und bleiben.",
    "Im Alltag geht dasselbe auch im Task-Manager unter „Autostart“."
  ],
  "begriffe": {
    "Registrierung (Registry)": "Die zentrale Einstellungsdatenbank von Windows, aufgebaut aus Schlüsseln (wie Ordner) und Werten.",
    "HKCU / HKLM": "HKEY_CURRENT_USER (Einstellungen des angemeldeten Benutzers) / HKEY_LOCAL_MACHINE (Einstellungen für den ganzen PC).",
    "Run-Schlüssel": "Registrierungsschlüssel, dessen Einträge Windows bei jeder Anmeldung startet.",
    "REG_SZ": "Ein Registrierungswert vom Typ Text."
  },
  "loesung": [
    "reg query HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
    "reg delete HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run /v SuperToolbarUpdater /f",
    "reg query HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"
  ]
