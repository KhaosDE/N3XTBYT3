  "ziel": {
    "adapter_aktiv": true
  },
  "hinweise": [
    "„ipconfig“ zeigt gar keinen Adapter an. Ist der Netzwerkadapter überhaupt eingeschaltet?",
    "„Get-NetAdapter“ listet alle Netzwerkadapter mit ihrem Status auf.",
    "Der Adapter „Ethernet“ ist deaktiviert. Schalte ihn ein: „Enable-NetAdapter -Name Ethernet“."
  ],
  "erklaerung": [
    "Der Netzwerkadapter war in Windows deaktiviert (Status „Disabled“). Ein deaktivierter Adapter",
    "taucht in „ipconfig“ gar nicht auf – das ist ein guter Hinweis. „Get-NetAdapter“ zeigt ihn trotzdem.",
    "„Enable-NetAdapter -Name Ethernet“ schaltet ihn wieder ein; danach holt er sich per DHCP eine Adresse",
    "und der Status ist „Up“. „PING: transmit failed. General failure.“ bedeutet: Windows konnte das Paket",
    "gar nicht erst losschicken."
  ],
  "begriffe": {
    "Netzwerkadapter": "Die Netzwerkkarte (oder WLAN-Karte) im PC. In Windows kann man sie ein- und ausschalten.",
    "Status Disabled / Up": "Disabled = in Windows ausgeschaltet. Up = eingeschaltet und verbunden. Disconnected = an, aber kein Kabel/Signal.",
    "LinkSpeed": "Geschwindigkeit der Verbindung zum Switch, z. B. 1 Gbps."
  },
  "loesung": [
    "ipconfig",
    "Get-NetAdapter",
    "Enable-NetAdapter -Name Ethernet",
    "ping 192.168.10.1"
  ]
}
