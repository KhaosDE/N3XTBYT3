  "hinweise": [
    "„Permission denied“ beim Starten heißt: Es fehlt ein Recht. Schau dir die Rechte der Datei an.",
    "„ls -l backup.sh“ zeigt die Rechte. Zum Starten braucht der Besitzer das x-Recht (ausführen). Rechte ändert „chmod“.",
    "„chmod u+x backup.sh“, danach „./backup.sh“."
  ],
  "erklaerung": [
    "Die Datei hatte die Rechte rw-r--r-- (644): lesen und schreiben, aber nicht ausführen.",
    "„chmod u+x backup.sh“ gibt dem Besitzer (u = user) das Ausführrecht (x). Danach steht rwxr--r-- da.",
    "Mit „bash backup.sh“ ginge es auch ohne x-Recht, weil dann bash die Datei liest und ausführt –",
    "zum direkten Starten mit ./backup.sh braucht es aber das x-Recht. ./ heißt: „im aktuellen Ordner“."
  ],
  "begriffe": {
    "rwx": "Lesen (r), schreiben (w), ausführen (x). Drei Gruppen: Besitzer, Gruppe, alle anderen.",
    "chmod": "Ändert Rechte. u+x = Besitzer bekommt x; 755 = rwxr-xr-x; 644 = rw-r--r--.",
    "./": "Der aktuelle Ordner. Programme im aktuellen Ordner startet man mit ./name.",
    "Shebang (#!/bin/bash)": "Erste Zeile eines Skripts: welches Programm es ausführen soll."
  },
  "loesung": [
    "./backup.sh",
    "ls -l backup.sh",
    "chmod u+x backup.sh",
    "./backup.sh"
  ]
