  "erklaeren": [
    "Mit Dateien arbeitest du im Terminal mit kurzen Befehlen: cat zeigt den Inhalt, mkdir legt einen Ordner an,",
    "cp kopiert, mv verschiebt (oder benennt um), rm löscht. Achtung: rm löscht sofort und endgültig – unter",
    "Linux gibt es im Terminal keinen Papierkorb und keine Rückfrage."
  ],
  "begriffe": {
    "cat": "Zeigt den Inhalt einer Datei (eigentlich: concatenate, aneinanderhängen).",
    "rm -r": "Löscht einen Ordner samt Inhalt (r = rekursiv, also mit allem darunter)."
  },
  "mitmachen": [
    {
      "text": "Geh in Dokumente: cd Dokumente",
      "eingabe": "cd Dokumente",
      "ziel": {
        "pfad": "/home/anna/Dokumente"
      },
      "danach": "Du bist in ~/Dokumente."
    },
    {
      "text": "Zeig die Einkaufsliste: cat einkauf.txt",
      "eingabe": "cat einkauf.txt",
      "danach": "cat zeigt den ganzen Inhalt. Für lange Dateien nimmt man less (blättern, q beendet)."
    },
    {
      "text": "Leg einen Ordner an: mkdir projekt",
      "eingabe": "mkdir projekt",
      "ziel": {
        "verzeichnis:/home/anna/Dokumente/projekt": true
      },
      "danach": "mkdir (make directory) legt einen Ordner an. Keine Ausgabe heißt: hat geklappt."
    },
    {
      "text": "Kopiere die Liste hinein: cp einkauf.txt projekt/",
      "eingabe": "cp einkauf.txt projekt/",
      "danach": "cp Quelle Ziel. Der Schrägstrich hinten macht klar: projekt ist ein Ordner."
    },
    {
      "text": "Benenne die Kopie um: mv projekt/einkauf.txt projekt/liste-alt.txt",
      "eingabe": "mv projekt/einkauf.txt projekt/liste-alt.txt",
      "danach": "mv verschiebt – im selben Ordner heißt das: umbenennen."
    },
    {
      "text": "Sieh nach: ls -l projekt",
      "eingabe": "ls -l projekt",
      "danach": "Darin liegt jetzt liste-alt.txt."
    },
    {
      "text": "Lösch die Datei: rm projekt/liste-alt.txt",
      "eingabe": "rm projekt/liste-alt.txt",
      "danach": "Weg – ohne Rückfrage. Darum vorher immer mit ls nachsehen, was du löschst."
    }
  ],
  "aufgaben": [
