  "situationen": [
    {
      "wenn": "… ich wissen will, in welchem Ordner ich bin?",
      "befehle": [
        "pwd"
      ],
      "lektion": "gk-lin-ordner"
    },
    {
      "wenn": "… ich sehen will, was in einem Ordner liegt – auch versteckte Dateien?",
      "befehle": [
        "ls -la"
      ],
      "lektion": "gk-lin-ordner"
    },
    {
      "wenn": "… ich nicht weiß, was ein Befehl tut oder wie er geht?",
      "befehle": [
        "whatis cp",
        "cp --help"
      ],
      "lektion": "gk-lin-hilfe",
      "erklaerung": "Ausführlich: man cp (q beendet)."
    },
    {
      "wenn": "… ich eine Textdatei lesen will?",
      "befehle": [
        "cat Dokumente/einkauf.txt"
      ],
      "lektion": "gk-lin-dateien"
    },
    {
      "wenn": "… ich einen Ordner samt Inhalt löschen will?",
      "befehle": [
        "ls -l Dokumente/rezepte",
        "rm -r Dokumente/rezepte"
      ],
      "lektion": "gk-lin-dateien",
      "erklaerung": "Erst nachsehen, dann löschen – es gibt keinen Papierkorb."
    },
    {
      "wenn": "… ich eine Einstellungsdatei ändern muss?",
      "befehle": [
        "sudo nano /etc/hostname"
      ],
      "lektion": "gk-lin-nano",
      "erklaerung": "Systemdateien gehören root – darum sudo. Strg+O speichert, Strg+X beendet."
    },
    {
      "wenn": "… ein Skript „Permission denied“ meldet?",
      "befehle": [
        "ls -l backup.sh",
        "chmod u+x backup.sh"
      ],
      "lektion": "gk-lin-rechte",
      "erklaerung": "Fehlt das x-Recht, darf niemand die Datei ausführen."
    },
    {
      "wenn": "… ich etwas mit Root-Rechten tun muss?",
      "befehle": [
        "sudo cat /etc/lagerscan/lizenz.conf"
      ],
      "lektion": "gk-lin-rechte"
    },
    {
      "wenn": "… ein Programm fehlt („command not found“)?",
      "befehle": [
        "sudo apt update",
        "sudo apt install htop"
      ],
      "lektion": "gk-lin-pakete"
    },
    {
      "wenn": "… ein Programm hängt?",
      "befehle": [
        "ps aux | grep soffice",
        "kill 4711",
        "kill -9 4711"
      ],
      "lektion": "gk-lin-prozesse",
      "erklaerung": "PID finden, höflich beenden, wenn nötig mit -9 erzwingen."
    },
    {
      "wenn": "… der PC kein Netzwerk hat?",
      "befehle": [
        "ip a",
        "ping -c 4 192.168.10.1"
      ],
      "lektion": "gk-lin-netzwerk",
      "erklaerung": "Steht bei der Karte state DOWN: sudo ip link set <karte> up."
    },
    {
      "wenn": "… ein Name zur falschen Adresse führt?",
      "befehle": [
        "getent hosts intranet.firma.internal",
        "host intranet.firma.internal",
        "grep intranet /etc/hosts"
      ],
      "lektion": "gk-lin-fehlersuche",
      "erklaerung": "Unterscheiden sich getent und host, steht oft ein alter Eintrag in /etc/hosts."
    }
  ]
}
