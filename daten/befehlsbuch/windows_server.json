    {
      "befehl": "Add-ADGroupMember",
      "was": "Nimmt jemanden in eine Gruppe auf.",
      "beispiel": "Add-ADGroupMember -Identity GG-Vertrieb -Members nbecker",
      "auch": [
        "Add-ADGroupMember GG-Vertrieb nbecker"
