    {
      "befehl": "Set-ADAccountExpiration",
      "was": "Setzt das Ablaufdatum eines Kontos.",
      "beispiel": "Set-ADAccountExpiration -Identity trichter -DateTime 2027-03-01",
      "auch": [
        "Set-ADAccountExpiration trichter -DateTime 2027-03-01"
      ],
      "parameter": {
        "-DateTime": "Das Datum. Das Konto läuft zu Beginn dieses Tages ab."
