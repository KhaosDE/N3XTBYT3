      "quelle": "https://learn.microsoft.com/powershell/module/activedirectory/get-aduser"
    },
    {
      "befehl": "Search-ADAccount",
      "was": "Sucht Konten mit Problemen (gesperrt, abgelaufen, deaktiviert …).",
