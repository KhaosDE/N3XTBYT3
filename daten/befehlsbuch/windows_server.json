      "vorher": [
        "Enter-PSSession -ComputerName srv-datei01"
      ],
      "quelle": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/exit-pssession?view=powershell-5.1"
    },
    {
      "befehl": "Get-ADUser",
