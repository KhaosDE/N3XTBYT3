  "situationen": [
    {
      "wenn": "… ich auf einem anderen Server arbeiten muss?",
      "befehle": [
        "Enter-PSSession -ComputerName srv-datei01"
      ],
      "lektion": "gk-srv-server"
    },
    {
      "wenn": "… ich prüfen will, auf welchem Server und mit welchem Konto ich arbeite?",
      "befehle": [
        "hostname",
        "whoami"
      ],
      "lektion": "gk-srv-server"
    },
    {
      "wenn": "… sich jemand nicht anmelden kann?",
      "befehle": [
        "Get-ADUser kwagner -Properties LockedOut",
        "Search-ADAccount -LockedOut"
      ],
      "lektion": "gk-srv-ad-benutzer",
      "erklaerung": "Gesperrt, deaktiviert oder abgelaufen? -Properties zeigt es."
    },
    {
      "wenn": "… ein Konto gesperrt ist?",
      "befehle": [
        "Unlock-ADAccount -Identity kwagner"
      ],
      "lektion": "gk-srv-ad-benutzer"
    },
    {
      "wenn": "… ein Konto abgelaufen ist (Praktikant, Aushilfe)?",
      "befehle": [
        "Get-ADUser trichter -Properties AccountExpirationDate",
        "Set-ADAccountExpiration -Identity trichter -DateTime 2027-03-01"
      ],
      "lektion": "gk-srv-fehlersuche"
    },
    {
      "wenn": "… jemand nicht an die Dateien seiner Abteilung kommt?",
      "befehle": [
        "Get-ADPrincipalGroupMembership nbecker",
        "Add-ADGroupMember -Identity GG-Vertrieb -Members nbecker"
      ],
      "lektion": "gk-srv-ad-gruppen",
      "erklaerung": "Rechte hängen an Gruppen: Fehlt die Gruppe, aufnehmen. Danach einmal ab- und wieder anmelden."
    },
    {
      "wenn": "… ich wissen will, wer in einer Gruppe ist?",
      "befehle": [
        "Get-ADGroupMember GG-Vertrieb"
      ],
      "lektion": "gk-srv-ad-gruppen"
    },
    {
      "wenn": "… ein Programm oder Befehl auf dem Server fehlt?",
      "befehle": [
        "Get-WindowsFeature *Backup*",
        "Install-WindowsFeature Windows-Server-Backup"
      ],
      "lektion": "gk-srv-features"
    },
    {
      "wenn": "… ein Gerät nur per IP-Adresse erreichbar ist, nicht per Name?",
      "befehle": [
        "Resolve-DnsName drucker02.firma.internal",
        "Add-DnsServerResourceRecordA -ZoneName firma.internal -Name drucker02 -IPv4Address 192.168.10.42"
      ],
      "lektion": "gk-srv-dns"
    },
    {
      "wenn": "… Geräte keine IP-Adresse bekommen (169.254…)?",
      "befehle": [
        "Get-DhcpServerv4ScopeStatistics",
        "Get-DhcpServerv4Scope"
      ],
      "lektion": "gk-srv-dhcp",
      "erklaerung": "Free 0 heißt: Bereich voll. Dann den Bereich vergrößern oder die Lease-Dauer kürzen."
    },
    {
      "wenn": "… ich wissen will, wer oder was den Server neu gestartet hat?",
      "befehle": [
        "Get-WinEvent -FilterHashtable @{LogName='System'; Id=1074} -MaxEvents 1 | Format-List"
      ],
      "lektion": "gk-srv-ereignisse",
      "erklaerung": "Ereignis 1074 im Protokoll System: Wer den Neustart ausgelöst hat."
    },
    {
      "wenn": "… ich sehen will, was zuletzt im Systemprotokoll steht?",
      "befehle": [
        "Get-WinEvent -LogName System -MaxEvents 5"
      ],
      "lektion": "gk-srv-ereignisse"
    }
