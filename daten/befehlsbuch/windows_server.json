      "wann": "Bevor du etwas änderst: Bin ich auf dem richtigen Server?",
      "lektion": "gk-srv-server",
      "quelle": "https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/hostname"
    },
    {
      "befehl": "whoami",
      "was": "Zeigt das angemeldete Konto (DOMÄNE\\benutzer).",
      "beispiel": "whoami",
      "wann": "Um zu sehen, mit welchem Konto du arbeitest.",
      "lektion": "gk-srv-server",
      "quelle": "https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/whoami"
    },
    {
      "befehl": "Enter-PSSession",
      "was": "Verbindet dich mit der PowerShell eines anderen Servers.",
      "beispiel": "Enter-PSSession -ComputerName srv-datei01",
      "auch": [
        "Enter-PSSession srv-datei01"
      ],
      "parameter": {
        "-ComputerName": "Name des Servers."
      },
      "wann": "Um einen Server aus der Ferne zu bedienen.",
      "lektion": "gk-srv-server",
      "quelle": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.core/enter-pssession?view=powershell-5.1"
    },
    {
      "befehl": "Exit-PSSession",
      "was": "Beendet die Fernverbindung (wie exit).",
      "beispiel": "Exit-PSSession",
      "wann": "Wenn du auf dem anderen Server fertig bist.",
