      "parameter": {
        "-LockedOut": "Gesperrte Konten.",
        "-AccountExpired": "Abgelaufene Konten.",
        "-AccountDisabled": "Deaktivierte Konten."
      },
      "wann": "Um alle betroffenen Konten auf einmal zu finden.",
      "lektion": "gk-srv-ad-benutzer",
      "quelle": "https://learn.microsoft.com/powershell/module/activedirectory/search-adaccount"
    },
    {
      "befehl": "Unlock-ADAccount",
      "was": "Entsperrt ein Konto.",
